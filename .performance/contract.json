      "metrics": [
        {
          "name": "exact-similarity-evaluations",
          "unit": "evaluations",
          "signal": "operation-count",
          "notes": "Exactly C however large the shared bucket is.",
          "growth": [
            {
              "dimension": "records",
              "bound": "constant"
            },
            {
              "dimension": "cap",
              "bound": "linear"
            }
          ]
        },
        {
          "name": "signature-probes",
          "unit": "lookups",
          "signal": "operation-count",
          "notes": "The first probe fills the cap.",
          "growth": [
            {
              "dimension": "records",
              "bound": "constant"
            },
            {
              "dimension": "cap",
              "bound": "constant"
            }
          ]
        },
        {
          "name": "bucket-entry-visits",
          "unit": "entries",
          "signal": "operation-count",
          "notes": "Traversal of the dense bucket stops at the cap.",
          "growth": [
            {
              "dimension": "records",
              "bound": "constant"
            },
            {
              "dimension": "cap",
              "bound": "linear"
            }
          ]
        }
      ]
