# runtime-onnx local environment contract.
# Copy only the entries you need into a local .env or export them in your shell.
# None of these settings is required for normal library use.

# External smoke model path. This matches the test's repository-relative fallback.
RUNTIME_ONNX_SMOKE_MODEL=.model-runtime/roberta-base-squad2-onnx/main/files/onnx/model_quantized.onnx

# Conservative diagnostic defaults. Diagnostics stay disabled unless explicitly enabled.
ONNX_RUNTIME_LOAD_DIAGNOSTICS=0
ONNX_RUNTIME_LOAD_MODE=file
ONNX_RUNTIME_LOG_LEVEL=verbose
ONNX_RUNTIME_LOG_VERBOSITY=4
ONNX_RUNTIME_DISABLE_SPINNING=0

# Used only when diagnostics are enabled; keep generated output in an ignored local path.
ONNX_RUNTIME_OPTIMIZED_MODEL_PATH=.model-runtime/runtime-onnx.optimized.onnx

# When using ort's load-dynamic feature, set the platform-specific runtime library path.
# ORT_DYLIB_PATH=/path/to/libonnxruntime.so
